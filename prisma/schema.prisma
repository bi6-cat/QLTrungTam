generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnrollmentStatus {
  active
  on_leave
}

enum InvoiceStatus {
  unpaid
  paid
  void
  waived
}

enum PaymentMethod {
  bank_transfer
  cash
}

enum ExpenseCategory {
  teacher_salary
  rent
  utilities
  supplies
  marketing
  other
}

model ClassRoom {
  id                      String          @id @default(cuid())
  name                    String
  shortCode               String          @unique
  /// Mã ngẫu nhiên của link nộp tiền phụ huynh: /pay/<MÃ LỚP>-<publicToken>.
  publicToken             String          @unique @default(cuid())
  /// Mã ngẫu nhiên riêng của link giáo viên: /teacher/classes/<MÃ LỚP>-<teacherToken>.
  teacherToken            String          @unique
  /// Mã 4 ký tự cũ (dùng chung cho phụ huynh và giáo viên); chỉ còn để chuyển hướng tạm.
  legacyToken             String?         @unique
  teacherName             String          @default("")
  /// Tài khoản giáo viên dạy lớp (cổng /teacher); null = chưa gán. teacherName vẫn là tên dùng cho
  /// lương, báo cáo và Google Sheet.
  teacherId               String?
  pricePerSession         Int
  sessionsPerMonthDefault Int
  /// Phần trăm học phí đã thu của lớp được trả cho giáo viên (0–100).
  teacherSharePercent     Int             @default(0)
  /// Ngày chốt lương riêng của lớp ("same:31" = cuối tháng, "next:5" = ngày 5 tháng sau);
  /// null = theo cài đặt chung. HS nộp sau ngày chốt được tính vào lương tháng sau.
  salaryCutoff            String?
  archivedAt              DateTime?
  createdAt               DateTime        @default(now())
  enrollments             Enrollment[]
  schedules               ClassSchedule[]
  sessions                ClassSession[]
  expenses                Expense[]
  salaryWriteOffs         SalaryWriteOff[]
  salaryCutoffs           ClassSalaryCutoff[]
  surveyLinks             SurveyClassLink[]
  surveyResponses         SurveyResponse[]
  teacher                 Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  assignments             Assignment[]
  materials               Material[]

  @@index([shortCode])
  @@index([publicToken])
  @@index([archivedAt])
  @@index([teacherId])
}

/// Lịch học cố định lặp theo tuần của một lớp.
model ClassSchedule {
  id        String    @id @default(cuid())
  classId   String
  /// 1 = Thứ 2 … 7 = Chủ nhật (theo ISO-8601).
  weekday   Int
  /// Giờ dạng "HH:mm" 24h.
  startTime String
  endTime   String
  room      String    @default("")
  note      String?
  /// Khoảng ngày lịch có hiệu lực (gồm cả hai đầu); null = không giới hạn. Ngừng lịch thì đặt
  /// effectiveTo thay vì xóa, để các buổi trước đó vẫn hiện đúng trên thời khóa biểu.
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, weekday])
  @@index([weekday])
}

enum ClassSessionStatus {
  held
  cancelled
  makeup
}

/// Điểm danh buổi học của cả lớp. Buổi theo lịch cố định chỉ có bản ghi khi đã điểm danh
/// (chưa có thì coi như học bình thường); buổi học bù luôn có bản ghi. Khớp với lịch theo
/// (lớp, ngày, giờ bắt đầu), nên đổi giờ lịch cố định không làm mất điểm danh cũ.
model ClassSession {
  id        String             @id @default(cuid())
  classId   String
  date      DateTime           @db.Date
  startTime String
  endTime   String
  room      String             @default("")
  status    ClassSessionStatus
  reason    String?
  /// Buổi học bù dời từ buổi ngày này (buổi gốc ghi là lớp nghỉ); null = bù chung.
  makeupForDate DateTime?      @db.Date
  markedBy  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  classRoom ClassRoom          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, date, startTime])
  @@index([date])
}

/// Chi phí vận hành theo tháng (lương giáo viên, thuê nhà, điện nước…).
model Expense {
  id             String          @id @default(cuid())
  month          Int
  year           Int
  category       ExpenseCategory @default(other)
  classId        String?
  description    String
  amount         Int
  /// Chỉ dùng khi category = teacher_salary: mỗi bản ghi là MỘT lần chuyển lương cho kỳ học
  /// phí (month/year); một kỳ có thể chuyển nhiều lần (trả trước, chuyển bù khi HS nộp muộn).
  /// sharePercent/baseAmount: % chia và học phí kỳ đã thu tại lúc ghi.
  sharePercent   Int?
  baseAmount     Int?
  /// Ngày chuyển tiền thực tế (lương giáo viên); có thể khác ngày ghi vào hệ thống.
  paidAt         DateTime?
  /// Hình thức trả lương: chuyển khoản hoặc tiền mặt đưa thêm (chỉ dùng cho teacher_salary).
  paymentMethod  PaymentMethod?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classRoom      ClassRoom?      @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([category, year, month])
  @@index([classId])
}

model Student {
  id          String       @id @default(cuid())
  fullName    String
  phone       String
  address     String
  parentName  String?
  note        String?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  account     StudentAccount?
  attempts    AssignmentAttempt[]

  @@index([phone])
  @@index([archivedAt])
}

model Enrollment {
  id               String            @id @default(cuid())
  studentId        String
  classId          String
  sessionsOverride Int?
  status           EnrollmentStatus  @default(active)
  /// Ngày học sinh bắt đầu học lớp (admin nhập khi thêm vào lớp hoặc khi quay lại học).
  startDate        DateTime          @default(now())
  /// Ngày đầu của tháng đầu tiên học sinh không còn học lớp này; null = đang học.
  leftAt           DateTime?
  createdAt        DateTime          @default(now())
  classRoom        ClassRoom         @relation(fields: [classId], references: [id], onDelete: Restrict)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoices         MonthlyInvoice[]
  months           EnrollmentMonth[]

  @@unique([studentId, classId])
  @@index([classId, status])
}

model EnrollmentMonth {
  id              String           @id @default(cuid())
  enrollmentId    String
  month           Int
  year            Int
  status          EnrollmentStatus @default(active)
  sessions        Int
  pricePerSession Int
  /// Ghi chú của học sinh trong lớp cho tháng này (chủ trung tâm hoặc quản lý phụ nhập).
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  enrollment      Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, month, year])
  @@index([year, month, status])
}

model MonthlyInvoice {
  id                     String        @id @default(cuid())
  enrollmentId           String
  month                  Int
  year                   Int
  sessions               Int
  pricePerSession        Int
  amount                 Int
  memoContent            String
  status                 InvoiceStatus @default(unpaid)
  statusReason           String?
  statusChangedAt        DateTime?
  paidAt                 DateTime?
  transactionId          String?       @unique
  /// Số tiền thực nhận khi hóa đơn được thanh toán (có thể khác amount khi gán lệch tiền).
  paidAmount             Int?
  /// Diễn giải số buổi lúc tạo hóa đơn (vd "đã trừ 1 buổi lớp nghỉ 15/10"), dùng trong tin nhắn.
  sessionsNote           String?
  studentNameSnapshot    String?
  studentPhoneSnapshot   String?
  classNameSnapshot      String?
  classShortCodeSnapshot String?
  teacherNameSnapshot    String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  enrollment             Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  transaction            Transaction?  @relation("InvoicePaymentTransaction", fields: [transactionId], references: [id])
  matchedTransaction     Transaction?  @relation("TransactionMatchedInvoice")

  @@unique([enrollmentId, month, year])
  @@index([status, month, year])
  @@index([memoContent])
}

model Transaction {
  id                  String          @id @default(cuid())
  gatewayRef          String          @unique
  amount              Int
  rawContent          String
  transferredAt       DateTime
  paymentMethod       PaymentMethod   @default(bank_transfer)
  matchedInvoiceId    String?         @unique
  matchedAt           DateTime?
  matchReason         String?
  matchOverrideReason String?
  reversedAt          DateTime?
  reversalReason      String?
  rawPayload          Json
  resolvedAt          DateTime?
  resolvedNote        String?
  createdAt           DateTime        @default(now())
  matchedInvoice      MonthlyInvoice? @relation("TransactionMatchedInvoice", fields: [matchedInvoiceId], references: [id])
  invoice             MonthlyInvoice? @relation("InvoicePaymentTransaction")

  @@index([matchedInvoiceId])
  @@index([transferredAt, id])
  @@index([matchedInvoiceId, resolvedAt, reversedAt, transferredAt, id], map: "Transaction_open_match_lookup_idx")
}

/// owner = chủ trung tâm (toàn quyền); manager = quản lý phụ (xem số liệu, nhập số buổi, xuất báo cáo).
enum AdminRole {
  owner
  manager
}

model AdminUser {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         AdminRole  @default(owner)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AuditLog {
  id            String     @id @default(cuid())
  actorUserId   String?
  actorUsername String
  action        String
  entityType    String
  entityId      String
  reason        String?
  metadata      Json?
  createdAt     DateTime   @default(now())
  actorUser     AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Bỏ qua dư nợ lương của một lớp-tháng (vd tháng trả lệch đã thỏa thuận xong với giáo viên):
/// phần chưa trả coi như xong và các khoản nộp muộn của tháng đó, đã nộp trước lúc bỏ qua, không
/// cộng sang lương tháng sau. Khoản nộp sau thời điểm bỏ qua vẫn tính lương bình thường.
model SalaryWriteOff {
  classId   String
  year      Int
  month     Int
  note      String?
  createdAt DateTime  @default(now())
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, year, month])
}

/// Ngày chốt lương đặt riêng cho một tháng lương (tháng đó trả lương khác ngày thường lệ).
/// Áp dụng cho các lớp theo ngày chốt chung; lớp có ngày chốt riêng giữ quy tắc của lớp.
model SalaryMonthCutoff {
  year       Int
  month      Int
  /// 0h (giờ máy chủ) của ngày chốt: tiền nộp đến hết ngày này tính vào lương tháng đó.
  cutoffDate DateTime
  updatedAt  DateTime @updatedAt

  @@id([year, month])
}

/// Ngày chốt lương đặt riêng cho một lớp trong một tháng lương. Ưu tiên hơn ngày chốt chung,
/// ngày đặt riêng của tháng và quy tắc riêng của lớp; HS nộp sau ngày này tính sang lương tháng sau.
model ClassSalaryCutoff {
  classId    String
  year       Int
  month      Int
  /// 0h (giờ máy chủ) của ngày chốt.
  cutoffDate DateTime
  updatedAt  DateTime  @updatedAt
  classRoom  ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, year, month])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum SurveyStatus {
  draft
  open
  closed
}

/// Ai trả lời khảo sát; "both" thì form hỏi người trả lời là học sinh hay phụ huynh.
enum SurveyAudience {
  student
  parent
  both
}

enum SurveyRespondent {
  student
  parent
}

enum SurveyQuestionType {
  rating
  nps
  single
  multi
  text
}

/// Nhóm đánh giá của câu hỏi, để gom điểm qua nhiều đợt khảo sát.
enum SurveyCategory {
  facilities
  teacher
  curriculum
  center
  other
}

/// Khảo sát ẩn danh gửi theo link từng lớp. Chỉ chủ trung tâm xem và quản lý.
model Survey {
  id           String            @id @default(cuid())
  title        String
  description  String            @default("")
  audience     SurveyAudience    @default(student)
  status       SurveyStatus      @default(draft)
  /// Hết ngày này (giờ Việt Nam) thì link tự ngừng nhận phiếu; null = mở đến khi đóng tay.
  closesOn     DateTime?         @db.Date
  /// Kết quả của một nhóm (lớp, giáo viên, đối tượng) chỉ hiện khi có ít nhất ngần này phiếu; 1 = luôn hiện.
  minGroupSize Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  questions    SurveyQuestion[]
  links        SurveyClassLink[]
  responses    SurveyResponse[]

  @@index([status])
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String
  position Int
  type     SurveyQuestionType
  category SurveyCategory     @default(other)
  prompt   String
  required Boolean            @default(true)
  /// Lựa chọn của câu chọn một / chọn nhiều; phiếu lưu số thứ tự lựa chọn.
  options  String[]           @default([])
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([surveyId, position])
}

/// Link khảo sát của một lớp: /survey/<MÃ LỚP>-<token>, gửi vào nhóm Zalo của lớp.
model SurveyClassLink {
  id        String    @id @default(cuid())
  surveyId  String
  classId   String
  token     String    @unique
  createdAt DateTime  @default(now())
  survey    Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([surveyId, classId])
}

/// Một phiếu trả lời ẩn danh. Cố ý KHÔNG lưu học sinh, IP, trình duyệt hay giờ nộp:
/// id là UUID ngẫu nhiên (cuid chứa thời điểm tạo) và chỉ giữ ngày nộp.
model SurveyResponse {
  id             String           @id @default(uuid())
  surveyId       String
  classId        String?
  /// Tên giáo viên của lớp lúc nộp, để kết quả cũ vẫn đúng người khi lớp đổi giáo viên.
  teacherName    String           @default("")
  respondentRole SurveyRespondent
  submittedOn    DateTime         @db.Date
  survey         Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  classRoom      ClassRoom?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  answers        SurveyAnswer[]

  @@index([surveyId, classId])
  @@index([submittedOn])
}

model SurveyAnswer {
  responseId String
  questionId String
  /// Số sao (1–5) hoặc điểm giới thiệu (0–10).
  value      Int?
  text       String?
  /// Số thứ tự các lựa chọn đã chọn (câu chọn một / chọn nhiều).
  choices    Int[]          @default([])
  /// Chủ trung tâm ẩn góp ý không phù hợp khỏi trang kết quả.
  hiddenAt   DateTime?
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([responseId, questionId])
  @@index([questionId])
}

/// Tài khoản giáo viên đăng nhập cổng /teacher (module identity).
model Teacher {
  id             String      @id @default(cuid())
  username       String      @unique
  passwordHash   String
  fullName       String
  /// Tăng khi đặt lại mật khẩu hoặc khoá tài khoản: cookie mang số cũ hết hiệu lực ngay.
  sessionVersion Int         @default(0)
  failedLogins   Int         @default(0)
  lockedUntil    DateTime?
  disabledAt     DateTime?
  /// Trung tâm bật cho giáo viên dạy ngoại ngữ: bộ từ vựng và bài kiểm tra từ vựng.
  vocabEnabled   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  classes        ClassRoom[]
  vocabSets      VocabSet[]
  assignments    Assignment[]
  materials      Material[]
}

/// Tài khoản học sinh đăng nhập cổng /learn bằng mã học sinh + PIN (module identity).
model StudentAccount {
  studentId      String    @id
  /// Tên đăng nhập dạng tên rút gọn + số, vd "HuongNV02" (tài khoản cũ còn mã ngẫu nhiên 6 ký tự).
  code           String    @unique
  /// code viết thường: học sinh gõ hoa hay thường đều đăng nhập được, và không cấp trùng khác hoa thường.
  codeKey        String    @unique
  pinHash        String
  sessionVersion Int       @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Học tập (module learning)
// ---------------------------------------------------------------------------

enum AssignmentKind {
  vocab_quiz
}

/// Bài giáo viên giao cho một lớp. Khung chung cho mọi loại bài; cấu hình riêng nằm ở bảng của
/// từng loại (VocabQuiz…).
model Assignment {
  id          String              @id @default(cuid())
  classId     String
  /// Giáo viên giao bài; null khi tài khoản giáo viên đã bị xoá (bài và kết quả vẫn giữ).
  teacherId   String?
  kind        AssignmentKind
  title       String
  opensAt     DateTime            @default(now())
  /// Hạn nộp; null = không hạn. Quá hạn thì không bắt đầu lượt mới được.
  dueAt       DateTime?
  /// Giáo viên đóng bài sớm.
  closedAt    DateTime?
  createdAt   DateTime            @default(now())
  classRoom   ClassRoom           @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher     Teacher?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  vocabQuiz   VocabQuiz?
  attempts    AssignmentAttempt[]

  @@index([classId, createdAt])
  @@index([teacherId, createdAt])
}

/// Một lượt làm bài của học sinh.
model AssignmentAttempt {
  id           String             @id @default(cuid())
  assignmentId String
  studentId    String
  /// Lượt thứ mấy của học sinh này trong bài (1, 2…).
  attemptNo    Int
  startedAt    DateTime           @default(now())
  submittedAt  DateTime?
  score        Int?
  maxScore     Int
  /// Nộp sau giới hạn thời gian (đã cộng thời gian ân hạn): vẫn chấm, giáo viên thấy cờ này.
  late         Boolean            @default(false)
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vocabItems   VocabAttemptItem[]

  @@unique([assignmentId, studentId, attemptNo])
  @@index([studentId])
}

/// Bộ từ vựng của giáo viên, dùng lại được cho nhiều bài và nhiều lớp.
model VocabSet {
  id          String      @id @default(cuid())
  teacherId   String
  title       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  archivedAt  DateTime?
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  words       VocabWord[]
  quizzes     VocabQuiz[]

  @@index([teacherId, archivedAt])
}

model VocabWord {
  id           String             @id @default(cuid())
  setId        String
  position     Int
  term         String
  meaning      String
  partOfSpeech String?
  example      String?
  set          VocabSet           @relation(fields: [setId], references: [id], onDelete: Cascade)
  attemptItems VocabAttemptItem[]

  @@index([setId, position])
}

/// Cấu hình bài kiểm tra từ vựng của một Assignment.
model VocabQuiz {
  assignmentId     String     @id
  setId            String
  /// Dạng câu hỏi được dùng (xem learning/vocab: mc_meaning, mc_term, type_term).
  questionTypes    String[]
  questionCount    Int
  /// Giới hạn thời gian mỗi lượt (phút); null = không giới hạn.
  timeLimitMinutes Int?
  maxAttempts      Int        @default(1)
  /// Sau khi nộp có cho học sinh xem đáp án đúng không.
  showAnswers      Boolean    @default(true)
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  set              VocabSet   @relation(fields: [setId], references: [id], onDelete: Restrict)
}

/// Một câu trong lượt làm bài từ vựng: đề được chụp lại lúc bắt đầu, nên sửa bộ từ về sau không
/// làm đổi bài đã làm. correctAnswer chỉ ở server, không gửi xuống trình duyệt trước khi nộp.
model VocabAttemptItem {
  attemptId     String
  position      Int
  /// Từ gốc; null khi giáo viên đã xoá từ khỏi bộ (câu và kết quả vẫn giữ).
  wordId        String?
  type          String
  prompt        String
  /// Các lựa chọn của câu trắc nghiệm; rỗng với câu gõ từ.
  options       String[]
  correctAnswer String
  answer        String?
  isCorrect     Boolean?
  attempt       AssignmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  word          VocabWord?        @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@id([attemptId, position])
  @@index([wordId])
}

/// Tài liệu giáo viên chia sẻ cho một lớp: đường dẫn (Google Drive, YouTube…) và/hoặc ghi chú.
/// Không lưu file trên máy chủ; tài liệu không có dữ liệu phụ thuộc nên xoá hẳn khi gỡ.
model Material {
  id        String    @id @default(cuid())
  classId   String
  /// Giáo viên đăng; null khi tài khoản giáo viên đã bị xoá (tài liệu vẫn giữ cho lớp).
  teacherId String?
  title     String
  /// Chỉ http/https (kiểm tra ở learning/materials).
  url       String?
  note      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([classId, createdAt])
  @@index([teacherId])
}
