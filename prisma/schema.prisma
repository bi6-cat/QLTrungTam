generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnrollmentStatus {
  active
  on_leave
}

enum InvoiceStatus {
  unpaid
  paid
  void
  waived
}

enum PaymentMethod {
  bank_transfer
  cash
}

enum ExpenseCategory {
  teacher_salary
  rent
  utilities
  supplies
  marketing
  other
}

model ClassRoom {
  id                      String          @id @default(cuid())
  name                    String
  shortCode               String          @unique
  /// Mã ngẫu nhiên của link nộp tiền phụ huynh: /pay/<MÃ LỚP>-<publicToken>.
  publicToken             String          @unique @default(cuid())
  /// Mã ngẫu nhiên riêng của link giáo viên: /teacher/classes/<MÃ LỚP>-<teacherToken>.
  teacherToken            String          @unique
  /// Mã 4 ký tự cũ (dùng chung cho phụ huynh và giáo viên); chỉ còn để chuyển hướng tạm.
  legacyToken             String?         @unique
  teacherName             String          @default("")
  pricePerSession         Int
  sessionsPerMonthDefault Int
  /// Phần trăm học phí đã thu của lớp được trả cho giáo viên (0–100).
  teacherSharePercent     Int             @default(0)
  /// Ngày chốt lương riêng của lớp ("same:31" = cuối tháng, "next:5" = ngày 5 tháng sau);
  /// null = theo cài đặt chung. HS nộp sau ngày chốt được tính vào lương tháng sau.
  salaryCutoff            String?
  archivedAt              DateTime?
  createdAt               DateTime        @default(now())
  enrollments             Enrollment[]
  schedules               ClassSchedule[]
  expenses                Expense[]
  salaryWriteOffs         SalaryWriteOff[]

  @@index([shortCode])
  @@index([publicToken])
  @@index([archivedAt])
}

/// Lịch học cố định lặp theo tuần của một lớp.
model ClassSchedule {
  id        String    @id @default(cuid())
  classId   String
  /// 1 = Thứ 2 … 7 = Chủ nhật (theo ISO-8601).
  weekday   Int
  /// Giờ dạng "HH:mm" 24h.
  startTime String
  endTime   String
  room      String    @default("")
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, weekday, startTime])
  @@index([classId])
  @@index([weekday])
}

/// Chi phí vận hành theo tháng (lương giáo viên, thuê nhà, điện nước…).
model Expense {
  id             String          @id @default(cuid())
  month          Int
  year           Int
  category       ExpenseCategory @default(other)
  classId        String?
  description    String
  amount         Int
  /// Chỉ dùng khi category = teacher_salary: mỗi bản ghi là MỘT lần chuyển lương cho kỳ học
  /// phí (month/year); một kỳ có thể chuyển nhiều lần (trả trước, chuyển bù khi HS nộp muộn).
  /// sharePercent/baseAmount: % chia và học phí kỳ đã thu tại lúc ghi.
  sharePercent   Int?
  baseAmount     Int?
  /// Ngày chuyển tiền thực tế (lương giáo viên); có thể khác ngày ghi vào hệ thống.
  paidAt         DateTime?
  /// Hình thức trả lương: chuyển khoản hoặc tiền mặt đưa thêm (chỉ dùng cho teacher_salary).
  paymentMethod  PaymentMethod?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classRoom      ClassRoom?      @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([year, month])
  @@index([category, year, month])
  @@index([classId])
}

model Student {
  id          String       @id @default(cuid())
  fullName    String
  phone       String
  address     String
  parentName  String?
  note        String?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]

  @@index([phone])
  @@index([archivedAt])
}

model Enrollment {
  id               String            @id @default(cuid())
  studentId        String
  classId          String
  sessionsOverride Int?
  status           EnrollmentStatus  @default(active)
  /// Ngày học sinh bắt đầu học lớp (admin nhập khi thêm vào lớp hoặc khi quay lại học).
  startDate        DateTime          @default(now())
  /// Ngày đầu của tháng đầu tiên học sinh không còn học lớp này; null = đang học.
  leftAt           DateTime?
  createdAt        DateTime          @default(now())
  classRoom        ClassRoom         @relation(fields: [classId], references: [id], onDelete: Restrict)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoices         MonthlyInvoice[]
  months           EnrollmentMonth[]

  @@unique([studentId, classId])
  @@index([classId, status])
}

model EnrollmentMonth {
  id              String           @id @default(cuid())
  enrollmentId    String
  month           Int
  year            Int
  status          EnrollmentStatus @default(active)
  sessions        Int
  pricePerSession Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  enrollment      Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, month, year])
  @@index([year, month, status])
}

model MonthlyInvoice {
  id                     String        @id @default(cuid())
  enrollmentId           String
  month                  Int
  year                   Int
  sessions               Int
  pricePerSession        Int
  amount                 Int
  memoContent            String
  status                 InvoiceStatus @default(unpaid)
  statusReason           String?
  statusChangedAt        DateTime?
  paidAt                 DateTime?
  transactionId          String?       @unique
  /// Số tiền thực nhận khi hóa đơn được thanh toán (có thể khác amount khi gán lệch tiền).
  paidAmount             Int?
  studentNameSnapshot    String?
  studentPhoneSnapshot   String?
  classNameSnapshot      String?
  classShortCodeSnapshot String?
  teacherNameSnapshot    String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  enrollment             Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  transaction            Transaction?  @relation("InvoicePaymentTransaction", fields: [transactionId], references: [id])
  matchedTransaction     Transaction?  @relation("TransactionMatchedInvoice")

  @@unique([enrollmentId, month, year])
  @@index([status, month, year])
  @@index([memoContent])
}

model Transaction {
  id                  String          @id @default(cuid())
  gatewayRef          String          @unique
  amount              Int
  rawContent          String
  transferredAt       DateTime
  paymentMethod       PaymentMethod   @default(bank_transfer)
  matchedInvoiceId    String?         @unique
  matchedAt           DateTime?
  matchReason         String?
  matchOverrideReason String?
  reversedAt          DateTime?
  reversalReason      String?
  rawPayload          Json
  resolvedAt          DateTime?
  resolvedNote        String?
  createdAt           DateTime        @default(now())
  matchedInvoice      MonthlyInvoice? @relation("TransactionMatchedInvoice", fields: [matchedInvoiceId], references: [id])
  invoice             MonthlyInvoice? @relation("InvoicePaymentTransaction")

  @@index([matchedInvoiceId])
  @@index([transferredAt, id])
  @@index([matchedInvoiceId, resolvedAt, reversedAt, transferredAt, id], map: "Transaction_open_match_lookup_idx")
}

model AdminUser {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AuditLog {
  id            String     @id @default(cuid())
  actorUserId   String?
  actorUsername String
  action        String
  entityType    String
  entityId      String
  reason        String?
  metadata      Json?
  createdAt     DateTime   @default(now())
  actorUser     AdminUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Bỏ qua dư nợ lương của một lớp-tháng (vd tháng trả lệch đã thỏa thuận xong với giáo viên):
/// phần chưa trả coi như xong và các khoản nộp muộn của tháng đó, đã nộp trước lúc bỏ qua, không
/// cộng sang lương tháng sau. Khoản nộp sau thời điểm bỏ qua vẫn tính lương bình thường.
model SalaryWriteOff {
  classId   String
  year      Int
  month     Int
  note      String?
  createdAt DateTime  @default(now())
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, year, month])
}

/// Ngày chốt lương đặt riêng cho một tháng lương (tháng đó trả lương khác ngày thường lệ).
/// Áp dụng cho các lớp theo ngày chốt chung; lớp có ngày chốt riêng giữ quy tắc của lớp.
model SalaryMonthCutoff {
  year       Int
  month      Int
  /// 0h (giờ máy chủ) của ngày chốt: tiền nộp đến hết ngày này tính vào lương tháng đó.
  cutoffDate DateTime
  updatedAt  DateTime @updatedAt

  @@id([year, month])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
