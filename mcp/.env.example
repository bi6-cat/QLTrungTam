# Copy thành mcp/.env.local (file này đã được .gitignore) rồi điền giá trị thật.

# --- Cách 1: DB staging trên EC2 qua SSH tunnel (script tự mở/đóng tunnel) ---
SSH_HOST=ubuntu@95.40.230.150
SSH_KEY=~/keychain/ec2-linh.pem
# Cổng local tuỳ chọn (15432 chỉ là ví dụ); user/mật khẩu/tên DB lấy từ POSTGRES_USER, DB_PASSWORD,
# POSTGRES_DB trong /opt/QLTrungTam/.env trên server. Mật khẩu có ký tự đặc biệt cần URL-encode.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15432/DBNAME?schema=public
DB_PASSWORD=
POSTGRES_DB=
POSTGRES_USER=
# --- Cách 2: DB dev local (docker compose dev, cổng 5433): bỏ SSH_HOST/SSH_KEY, dùng ---
# DATABASE_URL=postgresql://qltrungtam:dev-only-change-me@127.0.0.1:5433/qltrungtam?schema=public

# Bật tool sửa hồ sơ học sinh (thêm/sửa/lưu trữ/xoá). Bỏ dòng này hoặc đặt false = chỉ đọc.
MCP_ALLOW_WRITE=true
