[Unit]
Description=QLTrungTam pgBackRest %i backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/opt/QLTrungTam/.env
ConditionPathExists=/opt/QLTrungTam/deploy/app/docker-compose.yml

[Service]
StateDirectory=qltrungtam-pgbackrest
StateDirectoryMode=0755
Type=oneshot
User=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/opt/QLTrungTam
UMask=0077
TimeoutStartSec=4h
ExecStart=/usr/bin/bash /opt/QLTrungTam/deploy/app/scripts/pgbackrest-backup.sh %i